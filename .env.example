# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-32-character-or-longer-secret"
CRON_SECRET="replace-with-a-cron-secret"

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/technova?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/technova?sslmode=require"

# Stripe (test mode)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="TechNova CRM <noreply@example.com>"

# Cloudflare R2 (required for file uploads)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Upstash Redis (optional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Monitoring (optional)
SENTRY_DSN=""
